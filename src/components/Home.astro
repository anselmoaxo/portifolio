---
import { getCollection } from 'astro:content';
import Hero from './Hero.astro';
import { contact, courses, experience, immersions, stack } from '../data/profile';
import { useTranslations, withBase, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const coursesHours = courses.reduce((s, c) => s + c.hours, 0);
const maxHours = Math.max(...courses.map((c) => c.hours));
const totalHours = 315;
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(t('contact.mail.subject'))}`;

const startYear = 2010;
const nowYear = new Date().getFullYear();
const years = Array.from({ length: nowYear - startYear + 1 }, (_, i) => startYear + i);

// Maturidade codificada no preenchimento da etiqueta
const levels = [
  { key: 'solid', title: t('stack.solid'), desc: t('stack.solid.desc'), items: stack.solid, chip: 'bg-ink text-paper border-ink' },
  { key: 'practice', title: t('stack.practice'), desc: t('stack.practice.desc'), items: stack.practice, chip: 'bg-surface text-ink border-ink/70' },
  { key: 'learning', title: t('stack.learning'), desc: t('stack.learning.desc'), items: stack.learning, chip: 'bg-transparent text-muted border-dashed border-faint' },
];

const wrap = 'mx-auto max-w-6xl px-4 sm:px-6';
const sectionY = 'py-20 sm:py-28';
const h2 = 'heading text-[clamp(2.4rem,5vw,3.75rem)] text-ink';
---

<Hero lang={lang} />

<!-- Sobre -->
<section id="sobre" class:list={[wrap, sectionY]} aria-labelledby="sobre-titulo">
  <h2 id="sobre-titulo" class={h2}>{t('about.title')}</h2>
  <div class="mt-10 grid gap-8 text-lg leading-relaxed text-muted md:grid-cols-2 md:gap-12 [&_strong]:font-semibold [&_strong]:text-ink">
    <p set:html={t('about.p1')} />
    <p set:html={t('about.p2')} />
  </div>
</section>

<!-- Experiência -->
<section id="experiencia" class="border-y border-line bg-surface" aria-labelledby="experiencia-titulo">
  <div class:list={[wrap, sectionY]}>
    <h2 id="experiencia-titulo" class={h2}>{t('exp.title')}</h2>
    {experience.map((job) => (
      <article class="mt-10">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h3 class="heading text-2xl text-ink sm:text-3xl">{job.role[lang]}</h3>
          <p class="font-semibold text-accent">{job.company}, {job.period[lang]}</p>
        </div>

        <!-- Linha do tempo: um tique por ano desde 2010 -->
        <div class="mt-8" aria-hidden="true">
          <div class="flex h-3 gap-[3px]">
            {years.map(() => <span class="flex-1 rounded-sm bg-accent"></span>)}
          </div>
          <div class="mt-2 flex justify-between text-sm text-faint">
            <span>{startYear}</span><span>{nowYear}</span>
          </div>
        </div>

        <ul class="mt-10 grid gap-x-12 gap-y-5 md:grid-cols-2">
          {job.items.map((item) => (
            <li class="border-l-2 border-line pl-4 leading-relaxed text-muted">{item[lang]}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<!-- Projetos -->
<section id="projetos" class:list={[wrap, sectionY]} aria-labelledby="projetos-titulo">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="projetos-titulo" class={h2}>{t('projects.title')}</h2>
    <p class="max-w-md text-muted">{t('projects.intro')}</p>
  </div>

  <ul class="mt-12 grid gap-5 md:grid-cols-2">
    {projects.map((p) => {
      const href = withBase(`projetos/${p.id}/`);
      return (
        <li class="group relative flex flex-col rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-accent sm:p-8">
          <!-- Fluxo de dados do projeto, da origem à entrega -->
          <ol class="flex flex-wrap items-center gap-y-2 text-sm" aria-label="Fluxo">
            {p.data.flow.map((step, i) => (
              <li class="flex items-center">
                {i > 0 && <span class="mx-1.5 h-0.5 w-4 bg-accent/60" aria-hidden="true"></span>}
                <span class:list={['rounded-md px-2 py-0.5 font-medium', i === p.data.flow.length - 1 ? 'bg-accent text-accent-ink' : 'bg-accent-soft text-ink']}>{step}</span>
              </li>
            ))}
          </ol>

          <h3 class="heading mt-6 text-2xl text-ink sm:text-[1.75rem]">
            <a href={href} class="after:absolute after:inset-0 after:rounded-2xl after:content-[''] focus-visible:outline-none group-has-[a:focus-visible]:outline-2">{p.data.title[lang]}</a>
          </h3>
          <p class="mt-3 leading-relaxed text-muted">{p.data.summary[lang]}</p>
          <p class="mt-4 font-medium text-ink">{p.data.impact[lang]}</p>

          <div class="mt-auto flex items-center justify-between gap-4 pt-8 text-sm">
            <span class="font-semibold text-accent group-hover:underline">{t('projects.details')}</span>
            <a href={p.data.github} class="relative z-10 font-medium text-muted hover:text-ink" rel="noopener noreferrer" target="_blank">{t('projects.code')} (GitHub)</a>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<!-- Stack -->
<section id="stack" class="border-y border-line bg-surface" aria-labelledby="stack-titulo">
  <div class:list={[wrap, sectionY]}>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="stack-titulo" class={h2}>{t('stack.title')}</h2>
      <p class="max-w-md text-muted">{t('stack.legend')}</p>
    </div>
    <div class="mt-12 divide-y divide-line border-y border-line">
      {levels.map((lvl) => (
        <div class="grid gap-4 py-7 md:grid-cols-[15rem_1fr] md:gap-10">
          <div class="flex items-start gap-3">
            <span class:list={['mt-1.5 size-4 shrink-0 rounded border-2', lvl.chip]} aria-hidden="true"></span>
            <div>
              <h3 class="font-semibold text-ink">{lvl.title}</h3>
              <p class="text-sm text-faint">{lvl.desc}</p>
            </div>
          </div>
          <ul class="flex flex-wrap gap-2">
            {lvl.items.map((s) => <li class:list={['rounded-full border-2 px-3.5 py-1 text-[0.95rem] font-medium', lvl.chip]}>{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Formação -->
<section id="formacao" class:list={[wrap, sectionY]} aria-labelledby="formacao-titulo">
  <h2 id="formacao-titulo" class={h2}>{t('edu.title')}</h2>

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <p class="text-sm font-medium text-faint">2007 — 2010</p>
      <h3 class="heading mt-2 text-2xl text-ink">{t('edu.degree')}</h3>
      <p class="mt-1 text-muted">{t('edu.uni')}</p>
    </div>
    <div class="rounded-2xl border-2 border-dashed border-accent/60 p-6 sm:p-8">
      <p class="text-sm font-semibold text-accent">{t('edu.inprogress')}</p>
      <h3 class="heading mt-2 text-2xl text-ink">{t('edu.ai')}</h3>
      <p class="mt-1 text-muted">{t('edu.ai.desc')}</p>
    </div>
  </div>

  <div class="mt-16 grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <div>
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-semibold text-ink">{t('edu.paths')}</h3>
        <p class="text-sm text-faint">{coursesHours}h</p>
      </div>
      <ul class="mt-6 space-y-5">
        {courses.map((c) => (
          <li>
            <div class="flex items-baseline justify-between gap-4">
              <p class="font-medium text-ink">{c.name}</p>
              <p class="shrink-0 text-sm font-semibold tabular-nums text-ink">{c.hours}h</p>
            </div>
            <div class="mt-1.5 h-2 rounded-full bg-line" aria-hidden="true">
              <div class="h-2 rounded-full bg-accent" style={`width:${(c.hours / maxHours) * 100}%`}></div>
            </div>
            <p class="mt-1.5 text-sm text-faint">{c.topics}</p>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="display text-[5.5rem] text-accent">{totalHours}h</p>
      <p class="mt-2 text-muted">{t('edu.total')}</p>

      <h3 class="mt-12 font-semibold text-ink">{t('edu.immersions')}</h3>
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {immersions.map((im) => (
          <li class="flex items-baseline justify-between gap-4 py-3">
            <span><span class="text-ink">{im.name}</span><span class="block text-sm text-faint">{im.detail}</span></span>
            <span class="text-sm font-semibold tabular-nums text-ink">{im.hours}h</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- Contato -->
<section id="contato" class="border-t border-line bg-surface" aria-labelledby="contato-titulo">
  <div class:list={[wrap, sectionY]}>
    <h2 id="contato-titulo" class={h2}>{t('contact.title')}</h2>
    <p class="mt-4 max-w-xl text-lg text-muted">{t('contact.lead')}</p>

    <a href={mailto} class="heading mt-10 inline-block text-[clamp(1.4rem,4.2vw,3.25rem)] break-all text-accent underline decoration-2 underline-offset-[0.18em] hover:decoration-4">
      {contact.email}
    </a>

    <ul class="mt-12 flex flex-wrap gap-3">
      <li><a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-ink/20 px-5 py-2.5 font-medium text-ink hover:border-ink/50">WhatsApp {contact.phone}</a></li>
      <li><a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-ink/20 px-5 py-2.5 font-medium text-ink hover:border-ink/50">LinkedIn</a></li>
      <li><a href={contact.github} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-ink/20 px-5 py-2.5 font-medium text-ink hover:border-ink/50">GitHub</a></li>
      <li><a href={withBase(contact.cv)} download class="inline-flex rounded-full bg-ink px-5 py-2.5 font-medium text-paper hover:opacity-85">{t('hero.cta.cv')}</a></li>
    </ul>
  </div>
</section>
