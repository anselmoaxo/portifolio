---
import { languages, homePath, useTranslations, withBase, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates?: Partial<Record<Lang, string>>;
}
const { lang, alternates = {} } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);

const nav = [
  ['sobre', t('nav.about')],
  ['experiencia', t('nav.experience')],
  ['projetos', t('nav.projects')],
  ['stack', t('nav.stack')],
  ['formacao', t('nav.education')],
  ['contato', t('nav.contact')],
] as const;

const langs = Object.entries(languages) as [Lang, string][];
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur supports-[backdrop-filter]:bg-paper/70">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="font-serif text-lg font-medium tracking-tight text-ink no-underline">
      Anselmo Xavier
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-6 text-sm text-muted">
        {nav.map(([id, label]) => (
          <li><a href={`${home}#${id}`} class="transition-colors hover:text-ink">{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <div role="group" aria-label={t('lang.label')} class="flex items-center font-mono text-xs">
        {langs.map(([code, label]) => {
          const href = alternates[code] !== undefined ? withBase(alternates[code]) : homePath(code);
          return (
            <a
              href={href}
              hreflang={code}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'rounded px-2 py-1.5 transition-colors',
                code === lang ? 'text-ink underline decoration-accent decoration-2' : 'text-faint hover:text-ink',
              ]}
            >{label}</a>
          );
        })}
      </div>
      <button
        type="button"
        id="theme-toggle"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
        class="ml-1 grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-line/60 hover:text-ink"
      >
        <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
