---
import Base from '../layouts/Base.astro';
import { withBase } from '../i18n/ui';
---
<Base lang="pt" title="Página não encontrada | Anselmo Xavier">
  <section class="mx-auto max-w-3xl px-4 py-32 sm:px-6">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-serif text-5xl font-light text-ink">Página não encontrada</h1>
    <p class="mt-5 text-lg text-muted">O endereço pode ter mudado. Page not found.</p>
    <a href={withBase('')} class="mt-8 inline-block rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper">Voltar ao início</a>
  </section>
</Base>
